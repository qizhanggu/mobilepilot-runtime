VLM_API_KEY=your_volcengine_ark_api_key

# Phase 3: GUI-Plus 主 Actor 与通用 VLM 基线（不要将真实 Key 写入此文件）
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MOBILEPILOT_ACTOR_MODEL=gui-plus-2026-02-26
MOBILEPILOT_VERIFIER_MODEL=qwen3.7-flash-2026-07-15
MOBILEPILOT_SUBGOAL_MODEL=qwen3.7-flash-2026-07-15
# Optional: omit these two to reuse DASHSCOPE_API_KEY / DASHSCOPE_BASE_URL.
MOBILEPILOT_VERIFIER_API_KEY=your_dashscope_api_key
MOBILEPILOT_VERIFIER_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MOBILEPILOT_VERIFIER_INPUT_PRICE_CNY_PER_M=0.2
MOBILEPILOT_VERIFIER_OUTPUT_PRICE_CNY_PER_M=0.8
MOBILEPILOT_BASELINE_MODEL=qwen3-vl-plus
MOBILEPILOT_API_TIMEOUT_SECONDS=90

